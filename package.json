{
  "name": "@damiro/stylo",
  "version": "0.19.0",
  "description": "A plain-text-first Markdown editor for React, with first-class LaTeX (KaTeX) support.",
  "type": "module",
  "license": "MIT",
  "author": "damiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsdamiro/stylo.git"
  },
  "homepage": "https://github.com/itsdamiro/stylo#readme",
  "bugs": "https://github.com/itsdamiro/stylo/issues",
  "keywords": [
    "react",
    "markdown",
    "editor",
    "codemirror",
    "katex",
    "latex",
    "wikilinks",
    "obsidian"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/stylo.js"
    },
    "./toolbar-settings": {
      "types": "./dist/toolbar-settings/index.d.ts",
      "import": "./dist/toolbar-settings.js"
    },
    "./styles.css": "./dist/styles.css",
    "./katex.css": "./dist/katex.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:package": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "build": "vite build && tsc -p tsconfig.build.json && cp katex.css dist/katex.css",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/search": "^6.7.2",
    "katex": "^0.16.47",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
